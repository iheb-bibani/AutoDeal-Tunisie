# Ne JAMAIS committer : identifiants réels
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# Fichiers Python courants
__pycache__/
*.pyc
.venv/
venv/

# Dossier de session Playwright/Patchright (cookies persistés pour automobile.tn)
user_data/

# Journaux d'exécution : régénérés à chaque run, ils créent des modifications
# à chaque commit automatique et polluent l'historique.
logs/
*.log

# Sauvegardes temporaires des scrapers (ex. tayara.csv.bak)
*.bak
.pytest_cache/
.ruff_cache/
*.tmp
.*.tmp
# Liens vus par run (consommés dans le même run par core/suivi_annonces.py)
data/raw/vus/
